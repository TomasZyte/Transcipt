# Telegram
BOT_TOKEN=123456:ABC...            # токен от @BotFather

# RunPod (уже работающий эндпоинт)
RUNPOD_ENDPOINT_ID=<ENDPOINT_ID>
RUNPOD_API_KEY=<RUNPOD_API_KEY>

# S3-совместимое хранилище (Cloudflare R2 / Backblaze B2 / MinIO)
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=transcribe
S3_ACCESS_KEY=<key>
S3_SECRET_KEY=<secret>
S3_REGION=auto
PRESIGN_TTL=3600

# БД и админы
DB_PATH=bot.db
ADMINS=<ваш_telegram_id>           # через запятую; кому доступна /newpromo
