# Explicit input to integration_test.py --env-file; never use production credentials.
# Copy to .env.integration-test (ignored by Git), outside tg-bot/.env.
TEST_BOT_ID=<test_bot_numeric_id>
TEST_BOT_USERNAME=<test_bot_username>
TEST_ALLOWED_USER_ID=<one_private_telegram_user_id>
BOT_TOKEN=<test_bot_token>
RUNPOD_ENDPOINT_ID=<dedicated_test_endpoint>
RUNPOD_API_KEY=<key_scoped_to_test_endpoint>
S3_ENDPOINT=https://<32_character_account_id>.r2.cloudflarestorage.com
S3_BUCKET=poslovnica-test
S3_ACCESS_KEY=<key_scoped_to_test_bucket>
S3_SECRET_KEY=<test_bucket_secret>
PROVIDER_TOKEN=
STARS_ENABLED=0
LOCAL_BOT_API=
# DB_PATH is derived automatically: .test-runtime/<TEST_BOT_ID>/bot.db.
TEST_MAX_JOBS=2
TEST_BUDGET_USD=2
# Account for previous tests outside this runner's journal; do not reset between runs.
TEST_PRIOR_SPEND_USD=0.10
