# ── Общее ────────────────────────────────────────────────────────────────
HF_TOKEN=hf_xxx                       # токен HuggingFace (нужен pyannote для диаризации)

# ── Продакшн: переключение воркера на RunPod Serverless ──────────────────
# (в docker-compose.dev воркер локальный, эти переменные не нужны)
DISPATCH_BASE_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>
DISPATCH_API_KEY=<RUNPOD_API_KEY>

# ── Хранилище (S3-совместимое: Cloudflare R2 / Backblaze B2 / MinIO) ─────
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=transcribe
S3_ACCESS_KEY=<key>
S3_SECRET_KEY=<secret>
S3_REGION=auto
PRESIGN_TTL=3600

# ── Очередь / API ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
MAX_UPLOAD_MB=500
CORS_ORIGINS=https://your-frontend.example

# ── Воркер: модели ───────────────────────────────────────────────────────
DEVICE=cuda
COMPUTE_TYPE=float16                   # int8 = экономнее по VRAM
ASR_MODEL=large-v3
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
