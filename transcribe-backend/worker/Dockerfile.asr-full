# TEST ONLY: full ASR/alignment/diarization candidate, never production.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
ARG ASR_MODEL=large-v3
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 \
    ASR_COMPARISON_IMAGE=1 ASR_COMPARISON_TEST=0 ASR_IMAGE_MODEL=${ASR_MODEL} \
    HF_HUB_DISABLE_TELEMETRY=1 PYANNOTE_METRICS_ENABLED=0
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.quality.txt ./
RUN pip install --no-cache-dir -r requirements.quality.txt && pip check
ENV LD_LIBRARY_PATH=/opt/conda/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/conda/lib/python3.11/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}
RUN python -c "import ctypes; ctypes.CDLL('libcublas.so.12'); ctypes.CDLL('libcudnn_cnn.so.9').cudnnCreateConvolutionDescriptor"
COPY asr_comparison.py asr_comparison_handler.py prepare_asr_assets.py asr_model_sources.json quality_batch_handler.py ./
RUN python prepare_asr_assets.py --model ${ASR_MODEL} --destination /opt/asr --download
COPY prepare_full_assets.py full_model_sources.json ./
RUN python prepare_full_assets.py --destination /opt/full
ENV FULL_PIPELINE_IMAGE=1 FULL_PIPELINE_TEST=0 CONTEXT_ASR_TEST=0 SPEAKER_COMPARISON_TEST=0 SHORT_TURN_COMPARISON_TEST=0 NLTK_DATA=/opt/full/nltk
COPY full_pipeline.py full_pipeline_handler.py contextual_asr.py context_pipeline.py speaker_comparison.py short_turn_comparison.py transcript_segments.py quality_diagnostics.py ./
# CPU load validates public alignment assets; gated Community-1 stays test-runtime only.
RUN python -c "from asr_comparison import offline_models; from prepare_full_assets import verify_bundle,verify_nltk; import full_pipeline_handler,speaker_comparison,whisperx; verify_bundle('/opt/full/alignment','alignment'); verify_nltk('/opt/full'); ctx=offline_models(); ctx.__enter__(); whisperx.load_align_model('ru','cpu',model_name='/opt/full/alignment',model_cache_only=True); print('FULL_PIPELINE_CPU_IMPORT_AND_ALIGNMENT_OK')"
CMD ["python", "full_pipeline_handler.py"]
