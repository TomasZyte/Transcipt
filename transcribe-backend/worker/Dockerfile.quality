# TEST ONLY: select this file explicitly on poslovnica-test, never Transcipt.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 \
    QUALITY_BENCHMARK=1 QUALITY_PROFILE=community DIARIZATION_MODEL=pyannote/speaker-diarization-community-1 \
    ASR_MODEL=large-v3 BATCH_SIZE=8 PYANNOTE_METRICS_ENABLED=0 HF_HUB_DISABLE_TELEMETRY=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.quality.txt ./
RUN pip install --no-cache-dir -r requirements.quality.txt && pip check
COPY pipeline.py transcript_segments.py quality_batch_handler.py ./
# Import checks only: builds do not download gated models or submit GPU jobs.
RUN python -c "import torch, whisperx; from whisperx.diarize import DiarizationPipeline; import pipeline; assert torch.version.cuda is not None; assert pipeline.QUALITY_BENCHMARK"
CMD ["python", "quality_batch_handler.py"]
